{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sendviax test-v0 envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "session_id", "sender", "expires_at", "salt", "nonce", "ciphertext"],
  "properties": {
    "version": {"const": "test-v0"},
    "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "session_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "sender": {"enum": ["owner", "peer"]},
    "expires_at": {"type": "integer"},
    "salt": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16}$"},
    "ciphertext": {"type": "string", "minLength": 22, "maxLength": 9792171, "pattern": "^[A-Za-z0-9_-]+$"}
  },
  "$comment": "Server additionally validates canonical base64url, decoded sizes, authenticated sender/session, expiry and uniqueness."
}
